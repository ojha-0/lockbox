generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  USER
  ADMIN
  ORGANIZATION
}

enum ProfileStatus {
  ACTIVE
  DISABLED
}

enum VerificationStatus {
  PENDING_VERIFICATION
  VERIFIED
  DECLINED
}

enum ConsentStatus {
  PENDING
  APPROVED
  DENIED
  REVOKED
}

model User {
  id             String        @id @default(cuid())
  firstName      String
  lastName       String?
  email          String        @unique
  phone          String?       @unique
  passwordHash   String
  role           Role          @default(USER)
  profileStatus  ProfileStatus @default(ACTIVE)
  profilePicture String?
  // ORGANIZATION accounts: plaintext API key shown in their dashboard so they
  // can paste it into their own systems. Null for USER/ADMIN accounts.
  apiKey         String?       @unique
  apiKeyIssuedAt DateTime?
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt
  lastLoginAt    DateTime?

  documents     Document[]    @relation("UserDocuments")
  reviewedDocs  Document[]    @relation("ReviewedByAdmin")
  refreshTokens RefreshToken[]
  actorLogs     ActivityLog[] @relation("ActorLogs")
  targetLogs    ActivityLog[] @relation("TargetLogs")
  passwordResets PasswordReset[]
  sharesSent     DocumentShare[] @relation("SharesSent")
  sharesReceived DocumentShare[] @relation("SharesReceived")
  personalDetails UserPersonalDetails?
  verifiedPersonalDetails UserPersonalDetails[] @relation("PersonalDetailsVerifier")
  consentRequests ConsentRequest[]
  orgVerificationsIssued OrgVerification[] @relation("OrgVerificationIssuer")
  orgVerificationsAbout  OrgVerification[] @relation("OrgVerificationSubject")
}

model UserPersonalDetails {
  id                         String   @id @default(cuid())
  userId                     String   @unique
  gender                     String?
  dateOfBirthAD              String?
  dobBS                      String?
  bloodGroup                 String?
  birthAddress               String?
  permanentAddress           String?
  temporaryAddress           String?
  citizenshipNumber          String?
  citizenshipType            String?
  citizenshipIssuingDistrict String?
  citizenshipIssueDate       String?
  citizenshipIssuingOfficer  String?
  passportNumber             String?
  nationality                String?
  passportIssueDate          String?
  passportExpiryDate         String?
  nin                        String?
  dlLicenseNumber            String?
  dlCategory                 String?
  dlIssueDate                String?
  dlExpiryDate               String?
  dlLicenseOffice            String?
  panNumber                  String?
  panRegisteredOffice        String?
  verificationStatus         VerificationStatus @default(PENDING_VERIFICATION)
  verifiedAt                 DateTime?
  verifiedById               String?
  rejectionReasonText        String?
  createdAt                  DateTime @default(now())
  updatedAt                  DateTime @updatedAt

  user       User  @relation(fields: [userId], references: [id], onDelete: Cascade)
  verifiedBy User? @relation("PersonalDetailsVerifier", fields: [verifiedById], references: [id])
}

model Document {
  id                   String             @id @default(cuid())
  userId               String
  fileName             String
  originalName         String
  mimeType             String
  size                 Int
  filePath             String
  documentType         String?
  documentLabel        String?
  verificationStatus   VerificationStatus @default(PENDING_VERIFICATION)
  uploadedAt           DateTime           @default(now())
  reviewedAt           DateTime?
  verifiedAt           DateTime?
  reviewedById         String?
  rejectionReasonCode  String?
  rejectionReasonText  String?
  createdAt            DateTime           @default(now())
  updatedAt            DateTime           @updatedAt

  user       User  @relation("UserDocuments", fields: [userId], references: [id], onDelete: Cascade)
  reviewedBy User? @relation("ReviewedByAdmin", fields: [reviewedById], references: [id])
  activityLogs ActivityLog[]
}

model ActivityLog {
  id               String   @id @default(cuid())
  actorUserId      String?
  targetUserId     String?
  targetDocumentId String?
  action           String
  entityType       String
  description      String
  metadata         Json?
  createdAt        DateTime @default(now())

  actor          User?     @relation("ActorLogs", fields: [actorUserId], references: [id])
  targetUser     User?     @relation("TargetLogs", fields: [targetUserId], references: [id])
  targetDocument Document? @relation(fields: [targetDocumentId], references: [id], onDelete: SetNull)
}

model RefreshToken {
  id        String   @id @default(cuid())
  userId    String
  tokenHash String   @unique
  expiresAt DateTime
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model DocumentShare {
  id                     String    @id @default(cuid())
  fromUserId             String
  toUserId               String
  documentType           String
  maskedNumber           String
  sharedAt               DateTime  @default(now())
  fullAccessStatus       String    @default("NONE")
  fullAccessRequestedAt  DateTime?
  fullAccessRespondedAt  DateTime?

  fromUser User @relation("SharesSent", fields: [fromUserId], references: [id], onDelete: Cascade)
  toUser   User @relation("SharesReceived", fields: [toUserId], references: [id], onDelete: Cascade)
}

model ThirdParty {
  id           String   @id @default(cuid())
  name         String
  clientId     String   @unique
  clientSecret String
  webhookUrl   String?
  isActive     Boolean  @default(true)
  createdAt    DateTime @default(now())

  consentRequests ConsentRequest[]
}

model ConsentRequest {
  id             String        @id @default(cuid())
  thirdPartyId   String
  userId         String
  scope          String[]
  status         ConsentStatus @default(PENDING)
  consentToken   String        @unique
  expiresAt      DateTime
  accessToken    String?       @unique
  accessExpiry   DateTime?
  createdAt      DateTime      @default(now())

  thirdParty ThirdParty @relation(fields: [thirdPartyId], references: [id], onDelete: Cascade)
  user       User       @relation(fields: [userId], references: [id], onDelete: Cascade)
}

// Audit trail for the public verification API: every lookup an organization
// makes against our /api/v1/verify endpoint is logged here so the
// organization's dashboard can display it.
model OrgVerification {
  id            String   @id @default(cuid())
  orgUserId     String
  subjectUserId String?
  queriedName   String
  queriedPhone  String
  verified      Boolean
  createdAt     DateTime @default(now())

  org         User  @relation("OrgVerificationIssuer", fields: [orgUserId], references: [id], onDelete: Cascade)
  subjectUser User? @relation("OrgVerificationSubject", fields: [subjectUserId], references: [id], onDelete: SetNull)

  @@index([orgUserId, createdAt])
}

model PasswordReset {
  id        String   @id @default(cuid())
  userId    String
  token     String   @unique
  expiresAt DateTime
  used      Boolean  @default(false)
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}
